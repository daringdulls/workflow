# ── Supabase ──────────────────────────────────────────────────────────────
# Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser. Used by webhook/API routes that
# need to bypass RLS (e.g. inbound sync from Pixel Booking Manager).
SUPABASE_SERVICE_ROLE_KEY=

# ── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Integrations ─────────────────────────────────────────────────────────
# Shared secret(s) used to verify inbound webhook signatures from connected
# Pixel applications. Comma-separated "app_key:secret" pairs, e.g.
# booking_manager:xxxx,pms:yyyy,restaurant:zzzz,reputation:wwww
PIXEL_WEBHOOK_SECRETS=

# Outbound relay to Pixel Stay PMS: when Pixel Booking Manager creates a
# reservation here, it's forwarded to PMS so the room gets blocked there too.
# PMS_WEBHOOK_URL is that deployment's /api/webhooks/pixel-core endpoint;
# PMS_WEBHOOK_SECRET must match PIXEL_CORE_WEBHOOK_SECRET in PMS's own
# environment variables exactly. Leave both blank to skip the relay.
PMS_WEBHOOK_URL=
PMS_WEBHOOK_SECRET=

# ── Pixel AI (B2C inquiry agent) ────────────────────────────────────────
# Anthropic API key — the agent that reads inquiries and drafts replies/quotes.
ANTHROPIC_API_KEY=
# Which organization inbound WhatsApp/email inquiries belong to (slug column
# on organizations). Single-org deployments only need this set once.
PIXEL_DEFAULT_ORGANIZATION_SLUG=cozy-hotels-maldives

# WhatsApp Cloud API (Meta). Verify token is whatever you choose when
# subscribing the webhook in the Meta dashboard; app secret verifies inbound
# signatures; access token + phone number ID are only needed to actually send
# the approved reply (leave blank to just draft without auto-sending).
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Inbound email webhook secret — point your provider (Postmark/Resend/SendGrid
# inbound parse) at /api/v1/webhooks/email?secret=<this value>.
EMAIL_INBOUND_SECRET=
# Outbound email send (Resend). Leave blank to just draft without auto-sending.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
