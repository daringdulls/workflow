# Password to unlock the dashboard (choose your own, this is your only login)
WORKFLOW_PASSWORD=change-me

# A long random string used to sign the login cookie. Generate one with:
# openssl rand -hex 32
SESSION_SECRET=change-me-too

# This is auto-added by Vercel when you attach a Postgres (Neon) database to
# this project from the Vercel dashboard -> Storage tab (it injects
# DATABASE_URL and a few related vars). You do not need to set this by hand
# in production. For local development, copy the DATABASE_URL Neon/Vercel
# gives you into a .env.local file (never commit that file).
DATABASE_URL=
